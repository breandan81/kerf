// Lesson 6 — placing parts in 3D
// A panel standing in a slot in a thicker base.

material("ply6", thickness = 6, color = "wood", sheet = [300, 200]);
material("ply3", thickness = 3, color = [0.85, 0.7, 0.5], sheet = [300, 200]);

t  = thickness("ply3");
tb = thickness("ply6");
gap = 0.2;          // slot clearance: the slot is this much wider than the panel

part("base", "ply6")
  difference() {
    rounded_square([120, 50], r = 6);
    translate([20, 25 - (t + gap) / 2]) square([80, t + gap]);   // the slot
  }

// face_y(t) stands a part up: its local y becomes height (z), and its
// thickness runs from y = 0 to y = t. Then translate centres it in the slot.
translate([20, 25 - t / 2, 0]) face_y(t)
  part("panel", "ply3") {
    square([80, 70]);
    engrave() translate([40, 45]) text("Hi!", size = 14, halign = "center");
  }
